<idea-plugin>
    <id>dev.gdx.markup.idea</id>
    <name>libgdx-ui-markup preview</name>
    <vendor>teemuki8</vendor>

    <description>Live preview and hot reload for libgdx-ui-markup Scene2D markup.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="GDXCSS"
                  language="GDXCSS"
                  implementationClass="dev.gdx.markup.idea.GdxCssFileType"
                  fieldName="INSTANCE"
                  extensions="gdxcss"/>
        <lang.syntaxHighlighterFactory language="GDXCSS"
                    implementationClass="dev.gdx.markup.idea.GdxCssSyntaxHighlighterFactory"/>
        <toolWindow id="Markup Preview"
                    anchor="right"
                    factoryClass="dev.gdx.markup.idea.MarkupPreviewToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="MarkupPreview.Launch"
                class="dev.gdx.markup.idea.LaunchMarkupPreviewAction"
                text="Launch markup preview"
                description="Launch the libgdx-ui-markup preview for this markup file">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
