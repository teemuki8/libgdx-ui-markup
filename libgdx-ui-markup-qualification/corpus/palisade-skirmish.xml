<?xml version="1.0" encoding="UTF-8"?>
<!-- Recreation of the agentic-palisade "Skirmish Configuration" screen (our own benchmark
     UI, spec-driven): a single centered settings panel on a near-black backdrop, with a
     copper top border, a cream heading, eight setting rows (labels left, controls right),
     a balance-modifiers section, and a bottom action row. The recreation palette mirrors
     the reference screenshot (#040d10 backdrop, #0c2024 panel, #c67852 copper accent,
     #e8e0d0 cream text) so the color component measures real palette fidelity. -->
<ui>
  <table id="root" width="1280" height="720" class="backdrop">
    <row/>
    <table id="palisade-panel" width="680" height="676" align="center top"
           class="panel" pad="0" pad-top="0">
      <row/>
      <table id="palisade-accent" width="680" height="4" class="accent-bar"/>
      <row/>
      <label id="palisade-title" class="title" text="Skirmish Configuration"
             width="600" height="40" align="center"/>
      <row/>
      <table id="palisade-settings" pad-left="36" pad-right="36" pad-top="4">
        <row/>
        <table id="row-map" width="600" height="40">
          <row/>
          <label id="map-label" text="Map" width="220" align="left"/>
          <selectbox id="map" items="The Northern Realms,The Great Army,The Seine,The Yellow Sky,The Eastern Muster,Ichi-no-Tani" width="330" height="36"/>
        </table>
        <row/>
        <table id="row-realm" width="600" height="40">
          <row/>
          <label id="realm-label" text="Player realm" width="220" align="left"/>
          <selectbox id="player-realm" items="Vestfold,Thegns,Althing,Kings" width="330" height="36"/>
        </table>
        <row/>
        <table id="row-rivals" width="600" height="40">
          <row/>
          <label id="rivals-label" text="Major rival count" width="220" align="left"/>
          <table id="rivals-control" width="330" align="right">
            <row/>
            <slider id="major-rivals" min="0" max="8" step="1" value="3" width="260" height="36"/>
            <label id="rivals-value" text="3" width="56" align="right"/>
          </table>
        </table>
        <row/>
        <table id="row-density" width="600" height="40">
          <row/>
          <label id="density-label" text="Petty realm density" width="220" align="left"/>
          <selectbox id="density" items="Low,Standard,High" width="330" height="36"/>
        </table>
        <row/>
        <table id="row-resources" width="600" height="40">
          <row/>
          <label id="resources-label" text="Starting resources" width="220" align="left"/>
          <selectbox id="resources" items="Low,Standard,High" width="330" height="36"/>
        </table>
        <row/>
        <table id="row-victory" width="600" height="40">
          <row/>
          <label id="victory-label" text="Victory condition" width="220" align="left"/>
          <selectbox id="victory" items="Conquest,Total War,Score" width="330" height="36"/>
        </table>
        <row/>
        <table id="row-difficulty" width="600" height="40">
          <row/>
          <label id="difficulty-label" text="AI difficulty" width="220" align="left"/>
          <selectbox id="difficulty" items="Easy,Standard,Hard" width="330" height="36"/>
        </table>
        <row/>
        <table id="row-speed" width="600" height="40">
          <row/>
          <label id="speed-label" text="Simulation speed" width="220" align="left"/>
          <selectbox id="speed" items="Normal,Fast" width="330" height="36"/>
        </table>
        <row/>
        <label id="balance-header" class="section" text="BALANCE MODIFIERS" width="600"
               height="28" align="left"/>
        <row/>
        <checkbox id="rich-harvest" text="High income" label="High income" width="260"/>
        <row/>
        <checkbox id="scarce-gold" text="Low income" label="Low income" width="260"/>
        <row/>
        <checkbox id="costly-cavalry" text="Higher cavalry cost" label="Higher cavalry cost" width="260"/>
      </table>
      <row/>
      <table id="palisade-footer" width="680" height="56" align="center center"
             class="panel-alt">
        <row/>
        <button id="cancel" text="CANCEL" name="Cancel" width="180" height="44"/>
        <button id="start-battle" class="primary" text="START BATTLE" name="Start battle"
                width="220" height="44"/>
      </table>
    </table>
  </table>
</ui>
