<?xml version="1.0" encoding="UTF-8"?>
<!-- Recreation of the agentic-palisade "Skirmish Configuration" screen (our own benchmark
     UI, spec-driven): a single centered settings panel on a near-black backdrop, with a
     copper top border, a cream heading, eight setting rows (labels left, controls right),
     a balance-modifiers section, and a bottom action row. The recreation palette mirrors
     the reference screenshot (#040d10 backdrop, #0c2024 panel, #c67852 copper accent,
     #e8e0d0 cream text) so the color component measures real palette fidelity. -->
<ui>
  <table id="root" width="1280" height="720" class="backdrop">
    <row/>
    <table id="palisade-panel" width="680" height="676" align="center top"
           class="panel" pad="0" pad-top="0">
      <table id="palisade-top-space" width="680" height="40"/>
      <row/>
      <row/>
      <table id="palisade-accent" width="680" height="5" class="accent-bar"/>
      <row/>
      <label id="palisade-title" class="heading"
             text="Skirmish Configuration" width="640" height="82" align="center"/>
      <row/>
      <table id="palisade-settings" width="578" pad="0" pad-top="0">
        <row/>
        <table id="row-map" width="578" height="62">
          <row/>
          <label id="map-label" text="Map" width="320" align="left"/>
          <selectbox id="map" items="The Northern Realms,The Great Army,The Seine,The Yellow Sky,The Eastern Muster,Ichi-no-Tani"
                     width="216" height="43" align="right center"/>
        </table>
        <row/>
        <table id="map-rule" width="578" height="1" class="panel-alt"/>
        <row/>
        <table id="row-realm" width="578" height="62">
          <row/>
          <label id="realm-label" text="Player realm" width="320" align="left"/>
          <selectbox id="player-realm" items="Vestfold,Thegns,Althing,Kings"
                     width="146" height="43" align="right center"/>
        </table>
        <row/>
        <table id="realm-rule" width="578" height="1" class="panel-alt"/>
        <row/>
        <table id="row-rivals" width="578" height="62">
          <row/>
          <label id="rivals-label" text="Major rival count" width="260" align="left"/>
          <slider id="major-rivals" min="0" max="8" step="1" value="3"
                  width="190" height="10" align="center center"/>
          <label id="rivals-value" text="3" width="24" align="right center"/>
        </table>
        <row/>
        <table id="rivals-rule" width="578" height="1" class="panel-alt"/>
        <row/>
        <table id="row-density" width="578" height="62">
          <row/>
          <label id="density-label" text="Petty realm density" width="320" align="left"/>
          <selectbox id="density" items="Low,Medium,High" width="102" height="43" align="right center"/>
        </table>
        <row/>
        <table id="density-rule" width="578" height="1" class="panel-alt"/>
        <row/>
        <table id="row-resources" width="578" height="62">
          <row/>
          <label id="resources-label" text="Starting resources" width="320" align="left"/>
          <selectbox id="resources" items="Low,Standard,High" width="110" height="43" align="right center"/>
        </table>
        <row/>
        <table id="resources-rule" width="578" height="1" class="panel-alt"/>
        <row/>
        <table id="row-victory" width="578" height="62">
          <row/>
          <label id="victory-label" text="Victory condition" width="320" align="left"/>
          <selectbox id="victory" items="Conquest,Total conquest,Score" width="164" height="43" align="right center"/>
        </table>
        <row/>
        <table id="victory-rule" width="578" height="1" class="panel-alt"/>
        <row/>
        <table id="row-difficulty" width="578" height="62">
          <row/>
          <label id="difficulty-label" text="AI difficulty" width="320" align="left"/>
          <selectbox id="difficulty" items="Easy,Standard,Hard" width="114" height="43" align="right center"/>
        </table>
        <row/>
        <table id="difficulty-rule" width="578" height="1" class="panel-alt"/>
        <row/>
        <table id="row-speed" width="578" height="62">
          <row/>
          <label id="speed-label" text="Simulation speed" width="320" align="left"/>
          <selectbox id="speed" items="Normal,Fast" width="98" height="43" align="right center"/>
        </table>
        <row/>
        <table id="speed-rule" width="578" height="1" class="panel-alt"/>
        <row/>
        <label id="balance-header" class="section" text="BALANCE MODIFIERS" width="578" height="28"
               align="left"/>
        <row/>
        <checkbox id="rich-harvest" text="High income" label="High income" width="260"/>
        <row/>
        <checkbox id="scarce-gold" text="Low income" label="Low income" width="260"/>
        <row/>
        <checkbox id="costly-cavalry" text="Higher cavalry cost" label="Higher cavalry cost" width="260"/>
      </table>
      <row/>
      <table id="palisade-footer" width="680" height="56" align="center center"
             class="panel-alt">
        <row/>
        <button id="cancel" text="CANCEL" name="Cancel" width="180" height="44"/>
        <button id="start-battle" class="primary" text="START BATTLE" name="Start battle"
                width="220" height="44"/>
      </table>
    </table>
  </table>
</ui>
