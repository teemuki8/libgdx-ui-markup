<?xml version="1.0" encoding="UTF-8"?>
<!-- Slay the Spire battle/shop reference: charcoal HUD, warm dungeon field, a luminous
     centered card, asymmetric combatants, and a dense fan of cards along the bottom edge. -->
<ui>
  <table id="root" class="backdrop" width="1280" height="720">
    <table id="hud" class="panel-alt" width="1280" height="58" expand="true" fill="true" pad="10">
      <label id="player-name" class="heading" text="MegaCrit   the Defect" width="220" align="left"/>
      <label id="player-hp" text="♥ 47/82" width="130" align="left"/>
      <label id="player-gold" text="◉ 86" width="110" align="left"/>
      <label id="floor" class="title" text="11th Floor" width="420" align="center"/>
      <label id="draw-pile" text="Deck 14" width="150" align="right"/>
    </table>
    <row/>
    <table id="battlefield" width="1280" height="492" expand="true" fill="true" pad="0">
      <table id="hero-zone" width="620" height="440" pad="18" align="center center">
        <label id="hero-orb" class="accent-bar" text="●  ◌  ◌"/>
        <row/>
        <label id="hero-name" class="heading" text="THE DEFECT"/>
        <row/>
        <label id="hero-status" text="47 / 82 HP   ◆"/>
        <row/>
        <progressbar id="hero-hp" min="0" max="82" value="47" width="240" height="16"/>
        <row/>
        <label id="hero-energy" text="4 / 3 ENERGY"/>
        <row/>
        <label id="hero-orb-status" class="section" text="Lightning  3     Focus  1"/>
        <row/>
        <label id="hero-potion" text="Potion   ●"/>
        <row/>
        <label id="hero-intent" class="muted" text="Turn 7"/>
        <row/>
        <label id="hero-power" text="Block  12   Buffs  2   Orbs  3"/>
        <row/>
        <label id="hero-relic" class="section" text="Focus  1  •  Lightning  3"/>
      </table>
      <table id="card-zone" class="panel-alt" width="300" height="360" pad="18" pad-top="160" align="center top">
        <label id="card-cost" class="title" text="0"/>
        <row/>
        <label id="card-name" class="title" text="Zap+"/>
        <row/>
        <label id="card-kind" class="section" text="SKILL"/>
        <row/>
        <label id="card-rule" class="heading" text="Channel 1 Lightning."/>
        <row/>
        <label id="card-target" text="Evoke   •   Channel"/>
        <row/>
        <label id="card-flavor" class="section" text="A spark in the dark."/>
      </table>
      <table id="enemy-zone" width="360" height="440" pad="18" align="center center">
        <label id="enemy-name" class="heading" text="THE AWAKENED ONE"/>
        <row/>
        <label id="enemy-intent" class="title" text="7   ⚡"/>
        <row/>
        <label id="enemy-status" text="30 / 50 HP"/>
        <row/>
        <progressbar id="enemy-hp" min="0" max="50" value="30" width="240" height="16"/>
        <row/>
        <label id="enemy-buff" class="section" text="Strength  2     Ritual"/>
        <row/>
        <label id="enemy-action" text="Intent: attack"/>
        <row/>
        <label id="enemy-block" text="Block  7   Debuffs  1   Vulnerable"/>
        <row/>
        <label id="enemy-armor" class="section" text="Intent  •  Attack  •  Damage  7"/>
        <row/>
      </table>
    </table>
    <row/>
    <table id="hand" class="panel-alt" width="1280" height="170" expand="true" fill="true" pad="12"
           align="center center">
      <table id="hand-spacer" width="160" height="1"/>
      <button id="card-strike-left" text="1   Strike" name="Strike" width="180" height="130"/>
      <button id="card-strike" text="1   Strike" name="Strike" width="180" height="130"/>
      <button id="card-dualcast" text="1   Dualcast" name="Dualcast" width="180" height="130"/>
      <button id="card-defend" text="1   Defend+" name="Defend" width="180" height="130"/>
      <button id="end-turn" class="primary" text="End Turn" name="End Turn" width="190" height="62"/>
    </table>
  </table>
</ui>
