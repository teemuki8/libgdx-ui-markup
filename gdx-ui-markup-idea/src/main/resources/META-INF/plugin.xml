<idea-plugin>
    <id>dev.gdx.markup.idea</id>
    <name>gdx-ui-markup preview</name>
    <vendor>teemuki8</vendor>

    <description>Live preview and hot reload for gdx-ui-markup Scene2D markup.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Markup Preview"
                    anchor="right"
                    factoryClass="dev.gdx.markup.idea.MarkupPreviewToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="MarkupPreview.Launch"
                class="dev.gdx.markup.idea.LaunchMarkupPreviewAction"
                text="Launch markup preview"
                description="Launch the gdx-ui-markup preview for this markup file">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
